{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PrismorSec/prismor/blob/main/docs/schemas/decisions.schema.json",
  "title": "Prismor evidence pack decision (prismor.evidence_pack.v1)",
  "type": "object",
  "required": ["seq", "record_hash", "ts", "kind", "action", "decision", "enforcement_outcome", "rules"],
  "properties": {
    "seq": {"type": ["integer", "null"], "description": "Position on the device's signed trail"},
    "record_hash": {"type": "string", "description": "Hash of the trail record in records.jsonl"},
    "ts": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["decision", "approval_outcome"]},
    "identity": {"type": "object", "properties": {
      "device_id": {"type": ["string", "null"]}, "signing_key_id": {"type": ["string", "null"]}}},
    "subject": {"type": "object", "description": "Human principal (user_id, team_id, roles, source)"},
    "agent": {"type": "object", "properties": {
      "framework": {"type": ["string", "null"]}, "name": {"type": ["string", "null"]},
      "subagent_id": {"type": ["string", "null"]}}},
    "session_id": {"type": ["string", "null"]},
    "action": {"type": "object", "properties": {
      "tool": {"type": ["string", "null"]}, "event_type": {"type": ["string", "null"]},
      "input_summary": {"type": ["string", "null"]}}},
    "resource": {"type": ["object", "null"], "description": "kind / id / attr as judged"},
    "policy": {"type": "object", "properties": {
      "version": {"type": ["integer", "null"]}, "profile_id": {"type": ["string", "null"]}}},
    "authority_hash": {"type": ["string", "null"], "description": "Name of authority/<hash>.json"},
    "decision": {"type": ["string", "null"], "description": "Verdict, or the approval status"},
    "mode": {"type": ["string", "null"], "enum": ["observe", "enforce", "", null]},
    "enforcement_outcome": {"enum": ["allowed", "observed", "held", "refused", "approved", "approved_redacted",
      "denied", "expired", "timeout", "request_failed", "revoked_after_approval", "revoked_before_commit",
      "cancelled_in_flight"]},
    "rules": {"type": "array", "items": {"type": "string"}},
    "refusing_rule": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "approval": {"type": ["object", "null"], "properties": {
      "id": {"type": ["string", "null"]}, "approver": {"type": ["object", "null"]}}}
  }
}
