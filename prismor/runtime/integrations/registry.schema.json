{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prismor integration registry",
  "type": "object",
  "required": [
    "schema",
    "agents"
  ],
  "properties": {
    "schema": {
      "const": "prismor.runtime.integrations.v1"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/integration"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "integration": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "surface",
        "status",
        "blocking"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "coding-agent",
            "framework",
            "multiplexer"
          ]
        },
        "surface": {
          "enum": [
            "hook-config",
            "sdk",
            "mcp",
            "rules-only",
            "http",
            "pass-through"
          ]
        },
        "status": {
          "enum": [
            "shipped",
            "roadmap",
            "sweep-only"
          ]
        },
        "blocking": {
          "enum": [
            "exit-2",
            "json-permission",
            "throw",
            "proxy-deny",
            "none",
            "client-side",
            "return-block"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_types": {
          "type": "array",
          "description": "Canonical event types this agent's adapter produces from the payloads the agent actually sends. A rule keyed on any other type never fires for this agent.",
          "uniqueItems": true,
          "items": {
            "enum": [
              "shell",
              "file_read",
              "file_write",
              "network",
              "prompt",
              "tool_result",
              "memory",
              "skill_manifest",
              "subagent_spawn",
              "ui_action"
            ]
          }
        },
        "config_paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "normalizer": {
          "type": [
            "string",
            "null"
          ]
        },
        "sweep_dir": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mirror": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "description": "Whether this agent's built-in tools can be REPLACED by Prismor's mirrored tools over MCP, and how.",
          "properties": {
            "status": {
              "enum": [
                "verified",
                "possible",
                "unsupported"
              ]
            },
            "scope": {
              "enum": [
                "project",
                "machine"
              ]
            },
            "disable": {
              "type": "string"
            },
            "verified": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
