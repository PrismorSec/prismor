#!/bin/bash
# Prismor package postinstall: keep this Mac's architecture, point
# /opt/prismor/current at the new version, then (re)configure from the
# configuration profile (domain dev.prismor) if one is installed.
set -u
VER=__VERSION__
ARCH=$(uname -m); [ "$ARCH" = arm64 ] || ARCH=x86_64
RT=/opt/prismor/runtime/$VER
for a in arm64 x86_64; do [ "$a" = "$ARCH" ] || rm -rf "${RT:?}/${a:?}"; done
ln -sfn "$RT/$ARCH" /opt/prismor/current
exec >>/var/log/prismor-install.log 2>&1
echo "=== $(date -u +%FT%TZ) install $VER ($ARCH)"
# A configuration profile for domain dev.prismor lands here. Read the file
# itself: cfprefsd can serve a stale view of a plist that just arrived.
PREF="/Library/Managed Preferences/dev.prismor.plist"
rd(){ [ -f "$PREF" ] && /usr/libexec/PlistBuddy -c "Print :$1" "$PREF" 2>/dev/null || true; }
MODE=$(rd Mode)
ARGS=(--mode "${MODE:-enforce}")
[ -n "$(rd EnforceRules)" ] && ARGS+=(--rules "$(rd EnforceRules)")
[ -n "$(rd FleetToken)" ] && ARGS+=(--token "$(rd FleetToken)")
[ -n "$(rd ApiBase)" ] && ARGS+=(--api-base "$(rd ApiBase)")
/opt/prismor/bin/prismor-mdm-setup "${ARGS[@]}"; rc=$?
# Older versions: hooks run through current/, so nothing points at them now.
for d in /opt/prismor/runtime/*; do [ "$d" = "$RT" ] || rm -rf "${d:?}"; done
echo "=== done rc=$rc"
exit $rc
